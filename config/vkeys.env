# SP1 verification keys for the Privacy V2 programs.
#
# Generated by: cargo run --release -p zk-pof-agent --bin print-vkeys
# REGENERATE whenever any guest program or crates/common changes and it is
# rebuilt (`cargo prove build`) — a vkey is a commitment to the exact ELF.
#
# Consumed by contracts/script/Deploy.s.sol:
#   source config/vkeys.env && forge script script/Deploy.s.sol ...
# or set on a live SolventSetOracle via setMembershipVKey / setDerivationVKey.

# program-membership/ — client-side solvent-set membership proofs
MEMBERSHIP_VKEY=0x009a7ee02790144396b495889446338fab4053501f73a981c91e7fe77e8b6e12

# program-solvent-set/ — Stage B proven set derivation (native ETH + ERC-20)
DERIVATION_VKEY=0x00b955068a36db3d61683869dfb8cb4ceb892ce3b2c942a8f46dfd1224b0203d

# program-receipt-scan/ — Stage B.2 candidate completeness
# (no on-chain consumer yet; reserved for the composition check)
RECEIPT_SCAN_VKEY=0x0021f93113a4f10e52b16db6f6698ea143f13cc78559c9a0fddc511eaf815f29
