# Web app configuration. Copy to `.env.local` and adjust.
#
# Everything here is optional: with none of it set, the app talks to the agent
# through the Vite dev proxy and shows a clearly-labeled "not configured" state
# wherever an on-chain read would appear.

# The Solvency Agent's HTTP API. Unset uses the dev proxy (/api → :3000).
# This value is also what the generated `zkpof-client` commands point at, so in
# production it must be an origin a separate process can reach.
VITE_AGENT_URL=http://localhost:3000

# SolventSetOracle — enables the on-chain panels: whether a root was actually
# published, whether it was proven (Stage B) or operator-asserted (Stage A),
# when it expires, and whether a nullifier has already been consumed. Without
# it the app cannot emit verifyMembership calldata, which needs the set index.
# VITE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# The chain the oracle above is deployed on. Set this whenever you set an
# oracle address: an address alone is ambiguous, and without it reads follow
# whatever network the wallet happens to be on. Unset falls back to the
# selected policy's own chain_id. The chain must have a transport configured
# in src/hooks/useWeb3.ts (mainnet, sepolia, and foundry/31337 by default).
# VITE_ORACLE_CHAIN_ID=1

# PolicyRegistry — optional; adds root TTL to the on-chain panels.
# VITE_POLICY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

VITE_CHAIN_ID=1
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
